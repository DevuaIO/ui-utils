{
  "name": "@devua-lab/ui-utils",
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build",
    "deploy:npm": "npm publish --access public",
    "lint": "biome lint ./src",
    "format": "biome format ./src --write",
    "check": "biome check --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "zustand": ">=5",
    "axios": ">=1",
    "zod": ">=4"
  },
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    },
    "./string": {
      "import": "./dist/string.js",
      "types": "./dist/string/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types/index.d.ts"
    },
    "./symbol": {
      "import": "./dist/symbol.js",
      "types": "./dist/symbol.d.ts"
    },
    "./decorator": {
      "import": "./dist/decorator.js",
      "types": "./dist/decorator/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "dependencies": {
    "dequal": "^2.0.3"
  }
}
